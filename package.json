{
  "name": "auto-compiler",
  "version": "0.2.0",
  "description": "Drag files in and convert them to PDF locally.",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "smoke": "electron src/smoke.js",
    "package:win": "electron-packager . DropPDF --platform=win32 --arch=x64 --out=dist --overwrite --prune=false --download.cacheRoot=.electron-cache --ignore=\"^/(dist|output|tmp|test|node_modules|\\.git|\\.electron-cache|\\.pnpm-store)\"",
    "test": "node --test"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1"
  }
}
